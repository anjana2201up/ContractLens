# ContractLens — Environment Variables
# Copy this to .env and fill in your values

# ── Anthropic AI ─────────────────────────────────────────────
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-paste-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-5

# ── MongoDB ───────────────────────────────────────────────────
# Get a free cluster at: https://mongodb.com/atlas
# Format: mongodb+srv://username:password@cluster.mongodb.net/contractlens
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/contractlens

# ── Server ────────────────────────────────────────────────────
PORT=3000
JWT_SECRET=change-this-to-a-long-random-secret-string
